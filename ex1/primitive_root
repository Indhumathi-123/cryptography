import math

def get_gcd(a, b):
    """Euclidean Algorithm to find GCD."""
    while b:
        a, b = b, a % b
    return abs(a)

def get_primitive_root(p):
    """Finds the smallest primitive root modulo a prime p."""
    if p == 2: return 1
    phi = p - 1
    n = phi
    factors = set()
    d = 2
    while d * d <= n:
        if n % d == 0:
            factors.add(d)
            while n % d == 0:
                n //= d
        d += 1
    if n > 1:
        factors.add(n)

    for g in range(2, p):
        is_primitive = True
        for f in factors:
            if pow(g, phi // f, p) == 1:
                is_primitive = False
                break
        if is_primitive:
            return g
    return None

